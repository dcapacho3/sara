<?xml version="1.0"?>
<robot name="sara_sim" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="laser_visual" default="false"/>
  <xacro:arg name="imu_visual"   default="false"/>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- sdformat's urdf2sdf multiplies each URDF <material><color> by 1.25 when
       converting to SDF, which clips/shifts colors (e.g. 0.894 grey -> 1.0
       white). These overrides set gz-sim's ambient/diffuse directly, bypassing
       that conversion, so Gazebo matches the true SolidWorks colors used in
       sara.urdf.xacro/RViz instead of the shifted ones. -->
  <gazebo reference="base_cart">
    <visual>
      <material>
        <ambient>0.86667 0.32157 0.15686 1</ambient>
        <diffuse>0.86667 0.32157 0.15686 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="base_platform">
    <visual>
      <material>
        <ambient>0.55 0.55 0.55 1</ambient>
        <diffuse>0.55 0.55 0.55 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <gazebo reference="base_weight">
    <visual>
      <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- mu1/mu2=0.7: rubber-on-concrete traction coefficient. Was 0.1
       (near-ice) - re-applying this session's re-add-incrementally test:
       0.1 low friction can cause wheel spin without real displacement
       once wheel torque is bounded (near-infinite torque would otherwise
       brute-force enough grip regardless). -->
  <gazebo reference="wheel_left_link">
    <mu1>0.7</mu1>
    <mu2>0.7</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>0.7</mu1>
    <mu2>0.7</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="caster_back_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor type="imu" name="imu">
      <always_on>true</always_on>
      <visualize>$(arg imu_visual)</visualize>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
    <material>Gazebo/FlatBlack</material>
  </gazebo>

  <!-- New Gazebo (gz-sim / Harmonic): motion and joint state come from
       gz-sim system plugins, not per-sensor gazebo_ros plugins. Sensor data
       (imu, scan below) is produced by the world's Sensors system plugin and
       reaches ROS through a ros_gz_bridge topic bridge, set up in the launch
       file, not declared here. -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <!-- Matches the xacro's own wheel joint origins (0.144 m each side of
           center), not the old Classic plugin's stale 0.160 m: that value
           was copied from stock TurtleBot3 Burger and never actually
           exercised, since nothing spawned this description into Classic. -->
      <wheel_separation>0.288</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel_out</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>

    <!-- Required for any <sensor type="force_torque"> to actually produce
         output (cart_weight_joint below) - it's a separate system from
         Physics/Sensors, must be loaded explicitly like DiffDrive/JSP above. -->
    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque">
    </plugin>
  </gazebo>

  <!-- Weight sensor: cart_weight_joint is where the physical design's load
       cell actually sits (base_weight = "TopeBascula", the load cell's
       contact plate; base_platform = the fixed side it presses against per
       the SolidWorks assembly). Reports the support-reaction wrench, i.e.
       the weight of everything resting on base_weight. -->
  <gazebo reference="cart_weight_joint">
    <sensor name="cargo_scale" type="force_torque">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>cart_weight_wrench</topic>
      <force_torque>
        <frame>child</frame>
        <measure_direction>child_to_parent</measure_direction>
      </force_torque>
    </sensor>
  </gazebo>

  <gazebo reference="base_scan">
    <material>Gazebo/FlatBlack</material>
    <sensor type="gpu_lidar" name="lds_lfcd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>$(arg laser_visual)</visualize>
      <update_rate>5</update_rate>
      <topic>scan</topic>
      <gz_frame_id>base_scan</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- 0.120m is the real LDS-01's hardware floor, but the mount
               position (base_scan) overlaps the shopping cart's own
               support structure (base_platform, sara.urdf.xacro), which
               the sensor genuinely sees at close range on both sim and
               real hardware. Confirmed at this exact commit: with this
               still at 0.120m, the robot never moved AT ALL (net
               displacement 0.000m over 200+s) - collision_monitor (part
               of Nav2 itself, not sara_safety) has no self-detection
               filter of its own, only a height filter, so it very
               plausibly treats the cart's own rods as an imminent
               collision from t=0.
               RE-MEASURED 2026-09-25 (empirically, in TestEmpty.world with
               this value temporarily at 0.120m so raw self-detection was
               visible, not reused from the figure below): true
               self-detection max is 0.172m, clustered at four ~10-degree
               angle bands (roughly 50-70, 120-130, 230-240, 300-310 deg),
               consistent with the basket's four mounting bars/corners, not
               spread uniformly. The previous 0.4m floor here was a
               "generous" round-up from an earlier, less precise 0.186m
               figure - more than double the real self-detection ceiling,
               which left Proximity Stop (sara_safety/scripts/
               proximity_stop.py) almost no usable zone between this floor
               and its own footprint-derived ~0.3m target radius. Set at
               0.2m instead: a real ~0.03m margin (about 3 sigma above the
               sensor's own 0.01m noise stddev) above the measured 0.172m
               ceiling, not doubled for comfort. Re-verified against the
               same Nav2 stuck-at-spawn regression this value's history is
               about (self-detection mistaken for an obstacle) before
               trusting it - see sara_nav2_testing_methodology memory. -->
          <min>0.2</min>
          <max>3.5</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
