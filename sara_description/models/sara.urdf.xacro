<?xml version="1.0" ?>
<robot name="sara" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:include filename="$(find sara_description)/models/common_properties.xacro"/>
  <xacro:include filename="$(find sara_description)/models/sara.gazebo.xacro"/>

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.010" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/bases/waffle_pi_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.064 0 0.047" rpy="0 0 0"/>
      <geometry>
        <box size="0.266 0.266 0.094"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.3729096e+00"/>
      <inertia ixx="8.7002718e-03" ixy="-4.7576583e-05" ixz="1.1160499e-04"
               iyy="8.6195418e-03" iyz="-3.5422299e-06"
               izz="1.4612727e-02" />
    </inertial>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0.0 0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/wheels/left_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0.0 -0.144 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/wheels/right_tire.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.018" radius="0.033"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="2.8498940e-02" />
      <inertia ixx="1.1175580e-05" ixy="-4.2369783e-11" ixz="-5.9381719e-09"
               iyy="1.1192413e-05" iyz="-1.4400107e-11"
               izz="2.0712558e-05" />
      </inertial>
  </link>

  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="-0.177 -0.064 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_right_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="-0.177 0.064 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_left_link">
    <collision>
      <origin xyz="0 0.001 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.030 0.009 0.020"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.005" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.0 0 0.068" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>

  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="-0.064 0 0.122" rpy="0 0 0"/>
  </joint>

  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.015 0 -0.0065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.073 -0.011 0.084" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <collision>
      <origin xyz="0.005 0.011 0.013" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.030 0.027"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="0.003 0.011 0.009" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <!-- Shopping cart superstructure, mounted flush with the top of the chassis deck.
       x=-0.064 matches the chassis mesh/scan_joint offset: base_link's origin is the wheel
       axle, not the visual center of the round plate, which sits 0.064m behind it.
       z=0.0915 is the top of waffle_pi_base.stl itself (91.5mm tall, scale 0.001), i.e. the
       standoffs (base_cart) start right at the deck surface, not artificially raised to
       clear the LIDAR (which sits off-center at x=-0.064 too, so it doesn't collide with
       the corner-mounted standoffs anyway). -->
  <joint name="cart_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_cart"/>
    <origin xyz="-0.064 0.0 0.0915" rpy="0 0 0"/>
  </joint>

  <link name="base_cart">
    <inertial>
      <origin xyz="0.00029076 0.0018904 0.0225" rpy="0 0 0"/>
      <mass value="0.0034946"/>
      <inertia ixx="5.3922E-07" ixy="6.2156E-23" ixz="1.2408E-23"
               iyy="5.3922E-07" iyz="1.8924E-21"
               izz="1.322E-08"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/base_cart.STL"/>
      </geometry>
      <material name="cart_orange">
        <color rgba="0.86667 0.32157 0.15686 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/base_cart.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="cart_platform_joint" type="fixed">
    <parent link="base_cart"/>
    <child link="base_platform"/>
    <origin xyz="0 0 0.041" rpy="0 0 0"/>
  </joint>

  <link name="base_platform">
    <inertial>
      <origin xyz="0.0037131 0.00016219 0.044512" rpy="0 0 0"/>
      <mass value="1.4652"/>
      <inertia ixx="0.0032997" ixy="8.2131E-06" ixz="-5.2149E-06"
               iyy="0.0030443" iyz="-1.1568E-06"
               izz="0.0037989"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/Base_platform.STL"/>
      </geometry>
      <!-- Base_platform is a merged multi-part assembly (scale/load-cell base,
           the basket, the display case, and a mounting plate) collapsed into
           one mesh by the SW export, with no per-part color data preserved.
           Using the original exported appearance (grey) instead of guessing
           a single color for the whole assembly. -->
      <material name="cart_grey">
        <color rgba="0.55 0.55 0.55 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/Base_platform.STL"/>
      </geometry>
    </collision>
  </link>

  <joint name="cart_weight_joint" type="fixed">
    <parent link="base_platform"/>
    <child link="base_weight"/>
    <origin xyz="0.015647 0 0.0552" rpy="0 0 0"/>
  </joint>

  <link name="base_weight">
    <inertial>
      <origin xyz="0.00067058 -1.299E-14 -0.0051801" rpy="0 0 0"/>
      <mass value="0.19409"/>
      <inertia ixx="0.00032968" ixy="8.3723E-15" ixz="1.2781E-06"
               iyy="0.0007598" iyz="-2.6448E-17"
               izz="0.0010856"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/Base_weight.STL"/>
      </geometry>
      <material name="cart_white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://sara_description/meshes/cart/Base_weight.STL"/>
      </geometry>
    </collision>
  </link>

</robot>
