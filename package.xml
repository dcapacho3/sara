<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlemart</name>
  <version>0.0.0</version>
  <description>SARA (Smart Autonomous Retail Assistant): ROS2 autonomous shopping-cart robot for structured retail environments, with Nav2-based navigation, weight-based safety interlock, and customer/worker GUIs. Runs identically in Gazebo simulation and on a real mecanum-wheel AGV.</description>
  <maintainer email="dcapacho3@gmail.com">David Capacho Parra</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
    <exec_depend>joint_state_publisher</exec_depend>
    <exec_depend>robot_localization</exec_depend>
    <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>xacro</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
   <exec_depend>rclpy</exec_depend>
   
     <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>  
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>nav2_util</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_core</depend>
  <depend>pluginlib</depend>

 
  <exec_depend>python3</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/global_planner_plugin.xml" />
  </export>
</package>
